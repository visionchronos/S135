# ==============================================================================
# NEXUS Longitudinal Outcome Intelligence Platform - Production Environment Template
# ==============================================================================
# NOTE: Copy this file to .env and configure all variables securely.
# NEVER commit real .env files to version control!
# ==============================================================================

# Application Environment (production | development | staging)
ENVIRONMENT=production
DEBUG=False

# Server Host & Port
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Cryptographic / Session Secret (Generate a 64+ char random string in production)
# Example command: openssl rand -hex 32
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION_2026

# Database Connection URL
# SQLite (default / local):
DATABASE_URL=sqlite:///./outcome_platform.db
# PostgreSQL (Recommended for cloud production):
# DATABASE_URL=postgresql://nexus_user:SECURE_DB_PASSWORD@db.internal.example.com:5432/nexus_outcomes

# Privacy & PII Protection
# When True, masks phone numbers, emails, and sensitive identifiers in public APIs
MASK_PII=True

# API Documentation (Swagger / ReDoc UI)
# Set to False in hardened production environments
DOCS_ENABLED=True

# CORS Allowed Origins (Comma-separated list of allowed domains)
# Example: https://nexus.gov.in,https://app.nexus-intelligence.org
CORS_ORIGINS=*

# Frontend Environment Variables
# API Base URL for frontend (leave empty for same-origin / reverse proxy)
VITE_API_BASE_URL=/api
